NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
POSTGRES_DB=hukmee
POSTGRES_USER=hukmee_app
POSTGRES_PASSWORD=replace_with_a_local_only_password
DATABASE_URL=postgresql://hukmee_app:change_me@localhost:5432/hukmee?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379 is also accepted as a connection fallback.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# CACHE_PREFIX=hukmee
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
SESSION_SECRET=replace_with_a_different_32_character_random_secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Optional local development accounts. If configured, set both EMAIL and PASSWORD.
# Passwords must be at least 12 characters.
# SEED_ADMIN_EMAIL=admin2@hukmee.local
# SEED_ADMIN_PASSWORD=Hukmee@Admin123
# SEED_ADMIN_NAME=Hukmee Admin
# SEED_VENDOR_EMAIL=vendor@hukmee.local
# SEED_VENDOR_PASSWORD=Hukmee@Vendor123
# SEED_VENDOR_NAME=Hukmee Vendor
# SEED_TECHNICIAN_EMAIL=technician@hukmee.local
# SEED_TECHNICIAN_PASSWORD=Hukmee@Tech12345
# SEED_TECHNICIAN_NAME=Hukmee Technician
# SEED_DELIVERY_PARTNER_EMAIL=delivery@hukmee.local
# SEED_DELIVERY_PARTNER_PASSWORD=Hukmee@Delivery123
# SEED_DELIVERY_PARTNER_NAME=Hukmee Delivery Partner

# Optional local development OTP. Set an explicit six-digit value to use a
# static code; it is never returned by the API. Leave unset to require a provider.
# OTP_DEV_STATIC_CODE=123456
# Production OTP requires a provider and policy configuration.
# OTP_PROVIDER_URL=https://otp-provider.example/send
# OTP_PROVIDER_TOKEN=replace_with_secret
# OTP_CHALLENGE_TTL_SECONDS=<approved value>
# OTP_MAX_ATTEMPTS=<approved value>

# Optional secure Vendor KYC configuration. Leave document requirements disabled
# until the applicable SOW/privacy policy confirms them.
KYC_DOCUMENT_ENCRYPTION_KEY=
# JSON object keyed by document type; no document type is mandatory by default.
VENDOR_KYC_DOCUMENT_POLICY=

VENDOR_KYC_BANK_DETAILS_REQUIRED=false

# ─── OAuth (Google + Facebook, same as davee backend) ────────────────────────
# Set these to enable Google/Facebook login. Leave blank to disable OAuth routes.
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# FACEBOOK_CLIENT_ID=your_facebook_client_id
# FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
# FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback

# Frontend URL for OAuth redirect after success/failure
FRONTEND_URL=http://localhost:3001
