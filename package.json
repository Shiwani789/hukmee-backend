{
  "name": "hukmee-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HUKMEE mobile repair platform API",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "tsx watch --include \"src/**/*\" --include \"prisma/**/*.ts\" --include \"*.json\" --include \".env\" --exclude \"node_modules/**\" --exclude \".git/**\" --exclude \"dist/**\" --exclude \"coverage/**\" --exclude \"logs/**\" --exclude \"*.log\" --exclude \"tmp/**\" --exclude \"temp/**\" --exclude \".tmp/**\" --exclude \"*.tmp\" src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prisma format && prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/**/*.ts\" \"*.json\" \"*.cjs\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prisma format && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/**/*.ts\" \"*.json\" \"*.cjs\" \"*.md\" \"docs/**/*.md\"",
    "test:integration": "jest --runInBand tests/auth.integration.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "chalk": "^4.1.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "express-session": "^1.18.2",
    "helmet": "8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.4.0",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "22.18.12",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
